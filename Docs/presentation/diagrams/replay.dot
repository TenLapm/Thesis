digraph replay {
  graph [rankdir=LR, fontname="Arial", fontsize=16, nodesep=0.35, ranksep=0.55, bgcolor="white", pad=0.1];
  node  [shape=box, fontname="Arial", fontsize=16, color="black", penwidth=1.3, margin="0.16,0.09"];
  edge  [color="black", arrowsize=0.8, penwidth=1.2, fontname="Arial", fontsize=14];

  Play [label="Session in Unity\n(Mono, frame loop)"];
  File [label="replay.json\nconfig, map, roster, seed,\ncommands with ticks,\nFNV-1a hash per tick", penwidth=2.2];
  Run  [label="thesis replay --per-tick\n(.NET 9, no Unity)"];
  Cmp  [label="same 64 bits\non every tick?", shape=diamond, margin="0.02,0.02"];
  Ok   [label="OK: rules ran\nidentically"];
  Bad  [label="First divergent\ntick is named"];
  Tel  [label="telemetry.jsonl made again:\nsame bytes as the file\nthe session wrote"];
  Play -> File -> Run -> Cmp;
  Cmp -> Ok [label=" yes"];
  Cmp -> Bad [label=" no"];
  Run -> Tel;
}
