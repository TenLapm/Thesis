<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>thesis</AssemblyName>
    <RootNamespace>Thesis.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The CLI is not Unity code, so its sources live here rather than under Assets/. -->
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Thesis.Core\Thesis.Core.csproj" />
    <ProjectReference Include="..\Thesis.Sim\Thesis.Sim.csproj" />
    <ProjectReference Include="..\Thesis.Learning\Thesis.Learning.csproj" />
    <ProjectReference Include="..\Thesis.Director\Thesis.Director.csproj" />
    <ProjectReference Include="..\Thesis.Harness\Thesis.Harness.csproj" />
  </ItemGroup>
</Project>
